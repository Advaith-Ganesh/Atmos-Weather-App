{
  "name": "atmos-weather",
  "version": "1.0.0",
  "description": "Weather for anywhere, rendered in the local time of the place you searched. React, TypeScript and the Visual Crossing Timeline API.",
  "keywords": [
    "weather",
    "forecast",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "visual-crossing",
    "timezone",
    "accessibility",
    "recharts"
  ],
  "author": "Advaith Ganesh",
  "license": "MIT",
  "homepage": "https://github.com/Advaith-Ganesh/Atmos-Weather-App#readme",
  "bugs": {
    "url": "https://github.com/Advaith-Ganesh/Atmos-Weather-App/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Advaith-Ganesh/Atmos-Weather-App.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
