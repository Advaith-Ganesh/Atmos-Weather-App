# Visual Crossing Timeline API key — https://www.visualcrossing.com/sign-up
# The free tier allows 1000 records per day, which is plenty for local use.
VITE_VISUAL_CROSSING_API_KEY=

# Optional. Only set this to point the app at a proxy or a stub server; leave it
# empty to use the real Visual Crossing endpoint.
VITE_VISUAL_CROSSING_BASE_URL=
